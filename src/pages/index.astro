---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/nav/Navbar.astro';
import Hero from '../components/sections/Hero.astro';
import OverviewSection from '../components/sections/OverviewSection.astro';
import Testimonials from '../components/sections/Testimonials.astro';
import ProblemSection from '../components/sections/ProblemSection.astro';
import UseCases from '../components/sections/UseCases.astro';
import Features from '../components/sections/Features.astro';
import WhyChoose from '../components/sections/WhyChoose.astro';
import CTASection from '../components/sections/CTASection.astro';
import Footer from '../components/ui/Footer.astro';
---
<BaseLayout
  title="Starmesh | Pipeline management and customer health from your calls"
  description="Starmesh reads your CRM and customer calls. Ask about pipeline and customer health in Claude or ChatGPT (beta), and every answer cites the call or record it came from."
>
  <Navbar />
  <main>
    <Hero />
    <OverviewSection />
    <Testimonials />
    <ProblemSection />
    <WhyChoose />
    <UseCases />
    <Features />
    <CTASection />
  </main>
  <Footer />
</BaseLayout>

---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/nav/Navbar.astro';
import Footer from '../components/ui/Footer.astro';

const categories = [
  {
    label: "Meetings & Calls",
    icon: `<path stroke-linecap="round" stroke-linejoin="round" d="m15.75 10.5 4.72-4.72a.75.75 0 0 1 1.28.53v11.38a.75.75 0 0 1-1.28.53l-4.72-4.72M4.5 18.75h9a2.25 2.25 0 0 0 2.25-2.25v-9a2.25 2.25 0 0 0-2.25-2.25h-9A2.25 2.25 0 0 0 2.25 7.5v9a2.25 2.25 0 0 0 2.25 2.25Z"/>`,
    integrations: [
      { name: "Zoom",             description: "Call recordings and transcripts, linked to the deal or account they belong to.",                  badge: "Source" },
      { name: "Microsoft Teams",  description: "Teams meetings and recordings, read for commitments, objections and who joined.",                 badge: "Source" },
      { name: "Google Meet",      description: "Meet transcripts and notes, linked to the deal or account.",                                       badge: "Source" },
      { name: "Gong",             description: "Gong call recordings and transcripts, cited back to the moment in the call.",                      badge: "Source" },
      { name: "Granola",          description: "Granola notes and transcripts, from your account or a single folder you pick.",                   badge: "Source" },
    ],
  },
  {
    label: "CRM",
    icon: `<path stroke-linecap="round" stroke-linejoin="round" d="M20.25 14.15v4.25c0 1.094-.787 2.036-1.872 2.18-2.087.277-4.216.42-6.378.42s-4.291-.143-6.378-.42c-1.085-.144-1.872-1.086-1.872-2.18v-4.25m16.5 0a2.18 2.18 0 0 0 .75-1.661V8.706c0-1.081-.768-2.015-1.837-2.175a48.114 48.114 0 0 0-3.413-.387m4.5 8.006c-.194.165-.42.295-.673.38A23.978 23.978 0 0 1 12 15.75c-2.648 0-5.195-.429-7.577-1.22a2.016 2.016 0 0 1-.673-.38m0 0A2.18 2.18 0 0 1 3 12.489V8.706c0-1.081.768-2.015 1.837-2.175a48.111 48.111 0 0 1 3.413-.387m7.5 0V5.25A2.25 2.25 0 0 0 13.5 3h-3a2.25 2.25 0 0 0-2.25 2.25v.894m7.5 0a48.667 48.667 0 0 0-7.5 0M12 12.75h.008v.008H12v-.008Z"/>`,
    integrations: [
      { name: "Salesforce", description: "Open opportunities, stages and accounts. Calls are linked to the right deal and account.", badge: "Source + Link" },
      { name: "Attio",      description: "Attio deals and companies, with the calls linked to each.",                                badge: "Source + Link" },
    ],
  },
  {
    label: "Email & Calendar",
    icon: `<path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 0 1-2.25 2.25h-15a2.25 2.25 0 0 1-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0 0 19.5 4.5h-15a2.25 2.25 0 0 0-2.25 2.25m19.5 0v.243a2.25 2.25 0 0 1-1.07 1.916l-7.5 4.615a2.25 2.25 0 0 1-2.36 0L3.32 8.91a2.25 2.25 0 0 1-1.07-1.916V6.75"/>`,
    integrations: [
      { name: "Gmail",           description: "Optional. Customer email threads that sit next to the calls on a deal or account.", badge: "Source" },
      { name: "Google Calendar", description: "Optional. Meeting schedules, used to match calls to the right deal.",              badge: "Source" },
    ],
  },
];

function slug(label: string) {
  return label.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/-+$/g, '');
}

const TOKEN = "pk_DJKjA6gBT_2eZzZT6CXz-w";
const logoPaths: Record<string, string> = {
  "Zoom":            "/zoom-logo.svg",
  "Salesforce":      "/salesforce-logo.svg",
  "Gmail":           "/gmail-logo.svg",
  "Microsoft Teams": "/microsoft-teams-logo.svg",
  "Google Calendar": "/google-calendar-logo.svg",
  "Google Meet":     "/google-meet-logo.svg",
};
const logoDomains: Record<string, string> = {
  "Gong":    "gong.io",
  "Granola": "granola.ai",
  "Attio":   "attio.com",
};
function logoSrc(name: string) {
  return logoPaths[name] ?? `https://img.logo.dev/${logoDomains[name] ?? 'example.com'}?token=${TOKEN}&size=64`;
}
const badgeColors: Record<string, string> = {
  "Source":       "bg-blue-500/10 border-blue-500/20 text-blue-400",
  "Source + Link":"bg-violet-500/10 border-violet-500/20 text-violet-400",
};
---
<BaseLayout
  title="Integrations — Starmesh"
  description="Connect the CRM and call recorder Starmesh reads for pipeline and customer health."
>
  <Navbar />

  <!-- Hero -->
  <section class="relative pt-32 pb-16 px-6 overflow-hidden">
    <div class="absolute inset-0 flex items-center justify-center pointer-events-none" aria-hidden="true">
      <div class="w-[500px] h-[300px] rounded-full" style="background: radial-gradient(ellipse, rgba(99,102,241,0.12) 0%, transparent 70%);"></div>
    </div>
    <div class="relative max-w-3xl mx-auto text-center">
      <p class="text-xs text-[#52525B] uppercase tracking-widest mb-4">Integrations</p>
      <h1 class="text-4xl md:text-5xl font-bold tracking-tight mb-5 text-balance">
        Reads the CRM and calls <span class="gradient-text">you already use</span>
      </h1>
      <p class="text-lg text-[#A1A1AA] max-w-xl mx-auto">
        Salesforce or Attio, plus Zoom, Granola, Gong, or Teams. Email and calendar when you want them. That’s the book pipeline and customer health are read from.
      </p>
    </div>
  </section>

  <!-- Two-column layout: sidebar + content -->
  <section class="pb-24 px-6">
    <div class="max-w-5xl mx-auto int-layout">

      <!-- Left sticky sidebar -->
      <aside class="int-sidebar">
        <p class="text-xs text-[#52525B] uppercase tracking-widest mb-4 px-3">Categories</p>
        <nav class="flex flex-col gap-1">
          {categories.map((cat) => (
            <a
              href={`#${slug(cat.label)}`}
              class="int-cat-link flex items-center gap-2.5 px-3 py-2 rounded-lg text-sm text-[#A1A1AA] transition-colors"
              data-cat={slug(cat.label)}
            >
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="flex-shrink-0 opacity-70">
                <Fragment set:html={cat.icon} />
              </svg>
              <span>{cat.label}</span>
            </a>
          ))}
        </nav>
      </aside>

      <!-- Main content -->
      <div class="space-y-16">
        {categories.map((cat) => (
          <div id={slug(cat.label)} class="int-section" style="scroll-margin-top: 5.5rem;">
            <!-- Category header -->
            <div class="flex items-center gap-3 mb-6">
              <div class="w-8 h-8 rounded-lg flex items-center justify-center flex-shrink-0" style="background: rgba(99,102,241,0.1); border: 1px solid rgba(99,102,241,0.2);">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#818CF8" stroke-width="1.5">
                  <Fragment set:html={cat.icon} />
                </svg>
              </div>
              <h2 class="text-lg font-semibold text-[#FAFAFA]">{cat.label}</h2>
              <div class="flex-1 h-px bg-white/[0.05]"></div>
            </div>

            <!-- Integration cards -->
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
              {cat.integrations.map((int) => (
                <div class="card p-5 flex flex-col gap-3 hover:border-indigo-500/30 transition-colors">
                  <div class="flex items-start justify-between">
                    <div class="flex items-center gap-3">
                      <img
                        src={logoSrc(int.name)}
                        width="36" height="36"
                        alt={int.name}
                        class="rounded-lg flex-shrink-0 w-9 h-9 object-contain"
                      />
                      <p class="font-semibold text-sm text-[#FAFAFA]">{int.name}</p>
                    </div>
                    <span class={`px-2 py-0.5 rounded-full text-[10px] font-medium border flex-shrink-0 ${badgeColors[int.badge] || ''}`}>
                      {int.badge}
                    </span>
                  </div>
                  <p class="text-xs text-[#A1A1AA] leading-relaxed">{int.description}</p>
                </div>
              ))}
            </div>
          </div>
        ))}
      </div>

    </div>
  </section>

  <!-- CTA -->
  <section class="py-16 px-6 border-t border-white/[0.06]">
    <div class="max-w-2xl mx-auto text-center">
      <h2 class="text-2xl font-bold mb-3">Don't see your tool?</h2>
      <p class="text-[#A1A1AA] mb-8">We're adding new integrations regularly. Get in touch and we'll prioritize yours.</p>
      <a href="/contact" class="btn-primary">Request an integration</a>
    </div>
  </section>

  <Footer />
</BaseLayout>

<script>
  const links = document.querySelectorAll('.int-cat-link');
  const sections = document.querySelectorAll('.int-section');

  // Highlight active category on scroll
  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          const id = entry.target.id;
          links.forEach((link) => {
            link.classList.toggle('active', link.getAttribute('data-cat') === id);
          });
        }
      });
    },
    { rootMargin: '-10% 0px -80% 0px', threshold: 0 }
  );
  sections.forEach((s) => observer.observe(s));

  // Smooth scroll with navbar offset on click
  links.forEach((link) => {
    link.addEventListener('click', (e) => {
      e.preventDefault();
      const id = link.getAttribute('data-cat');
      const target = id ? document.getElementById(id) : null;
      if (target) {
        const top = target.getBoundingClientRect().top + window.scrollY - 88;
        window.scrollTo({ top, behavior: 'smooth' });
      }
    });
  });
</script>

<style>
  .int-layout {
    display: grid;
    grid-template-columns: 200px 1fr;
    gap: 3rem;
    align-items: start;
  }

  .int-sidebar {
    position: sticky;
    top: 5.5rem;
  }

  .int-cat-link {
    color: #71717A;
  }
  .int-cat-link:hover {
    color: #FAFAFA;
    background: rgba(255,255,255,0.04);
  }
  .int-cat-link.active {
    color: #FAFAFA;
    background: rgba(139,92,246,0.12);
    border: 1px solid rgba(139,92,246,0.2);
  }
  .int-cat-link.active svg {
    opacity: 1;
    color: #8B5CF6;
  }

  @media (max-width: 768px) {
    .int-layout {
      grid-template-columns: 1fr;
    }
    .int-sidebar {
      position: static;
      display: flex;
      flex-wrap: wrap;
      gap: 0.5rem;
    }
    .int-sidebar p {
      display: none;
    }
    .int-sidebar nav {
      flex-direction: row;
      flex-wrap: wrap;
      gap: 0.5rem;
    }
    .int-cat-link {
      border: 1px solid rgba(255,255,255,0.08);
      border-radius: 999px;
      padding: 0.25rem 0.75rem;
      font-size: 0.75rem;
    }
  }
</style>

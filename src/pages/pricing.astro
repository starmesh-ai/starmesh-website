---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/nav/Navbar.astro';
import CTASection from '../components/sections/CTASection.astro';
import Footer from '../components/ui/Footer.astro';
import { APP_URL } from '../config';

const enterprise = [
  { text: 'Everything in Starter' },
  { text: 'Up to 12 months of history' },
  { text: 'Whole-team CRM, with Admin, Lead and Rep views' },
  { text: 'Admins can require sources for everyone' },
  { text: 'Price and seats agreed with you on a call' },
];

// Mirrors the app's Pricing page (chat_app/src/onboarding/plans.ts).
const starter = [
  { text: 'Connect your own CRM, calls, email and calendar' },
  { text: 'Up to 90 days of history' },
  { text: 'Syncs every day' },
  { text: 'Ask about your deals in Claude or ChatGPT (beta)' },
  { text: 'Every answer cites the call or record behind it' },
];

const sample = [
  { text: 'Sample sales book — 30 deals, 3 reps, real-sounding calls' },
  { text: 'Ask in Claude or ChatGPT (beta)' },
  { text: 'Every answer cites the call or record behind it' },
  { text: 'No card, no time limit' },
];

// Sample data runs in the web app, or inside Claude via the public Starmesh plugin.
const TRY_IN_CLAUDE_URL = 'https://github.com/starmesh-ai/starmesh-claude-plugin#install';
// Price and seats are agreed on a call we set up by email.
const CONTACT_URL = '/contact?source=pricing';
---
<BaseLayout
  title="Pricing — Starmesh"
  description="Try Starmesh on sample data in Claude or the web app. Pricing for your own CRM and calls is set on a call."
>
  <Navbar />
  <main class="pt-16">
    <section class="py-24 px-6">
      <div class="max-w-5xl mx-auto">
        <div class="text-center mb-16">
          <p class="text-xs text-[#71717A] uppercase tracking-widest mb-3">Pricing</p>
          <h1 class="text-4xl md:text-5xl font-bold tracking-tight mb-4">
            Start on sample data, <span class="gradient-text">then your own book</span>
          </h1>
          <p class="text-[#A1A1AA] text-lg max-w-xl mx-auto">Try pipeline and customer health on sample data for free. Connect your own CRM and calls on Starter, or talk to us about a team.</p>
          <p class="text-[#71717A] text-sm mt-4">Works in Claude, and in ChatGPT (beta, needs developer mode).</p>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 items-stretch">
          <div class="rounded-2xl overflow-hidden flex flex-col" style="border:1px solid rgba(255,255,255,.08); background:#0a0a0d;">
            <div class="px-8 py-8 border-b border-white/[0.06]">
              <p class="text-xs text-[#A1A1AA] uppercase tracking-widest font-bold mb-3">Sample data</p>
              <div class="flex items-baseline gap-2 mb-2">
                <span class="text-5xl font-bold text-[#FAFAFA] tracking-tight">$0</span>
              </div>
              <p class="text-[#71717A] text-sm">Sample data in the app or in Claude · no time limit</p>
            </div>
            <div class="px-8 py-8 flex-1">
              <p class="text-xs text-[#52525B] uppercase tracking-widest font-semibold mb-6">What's included</p>
              <ul class="grid grid-cols-1 gap-3">
                {sample.map(f => (
                  <li class="flex items-start gap-3">
                    <span class="text-primary flex-shrink-0 mt-1">
                      <svg width="12" height="12" viewBox="0 0 12 12" fill="none"><path d="M2 6l3 3 5-5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
                    </span>
                    <span class="text-sm text-[#A1A1AA] leading-snug">{f.text}</span>
                  </li>
                ))}
              </ul>
            </div>
            <div class="px-8 py-6 border-t border-white/[0.06] min-h-[10rem] flex flex-col justify-center" style="background:rgba(255,255,255,.01);">
              <a href={APP_URL} class="btn-primary w-full justify-center text-center">
                Get started
              </a>
              <a href={TRY_IN_CLAUDE_URL} target="_blank" rel="noopener" class="btn-ghost w-full justify-center text-center mt-3">
                Try it in Claude
              </a>
            </div>
          </div>

          <div class="rounded-2xl overflow-hidden flex flex-col" style="border:1px solid rgba(255,255,255,.14); background:#0a0a0d;">
            <div class="px-8 py-8 border-b border-white/[0.06]">
              <p class="text-xs text-[#A1A1AA] uppercase tracking-widest font-bold mb-3">Starter</p>
              <div class="flex items-baseline gap-2 mb-2">
                <span class="text-5xl font-bold text-[#FAFAFA] tracking-tight">$29</span>
                <span class="text-[#71717A] text-sm">per month</span>
              </div>
              <p class="text-[#71717A] text-sm">Analyze your own pipeline.</p>
            </div>
            <div class="px-8 py-8 flex-1">
              <p class="text-xs text-[#52525B] uppercase tracking-widest font-semibold mb-6">What's included</p>
              <ul class="grid grid-cols-1 gap-3">
                {starter.map(f => (
                  <li class="flex items-start gap-3">
                    <span class="text-primary flex-shrink-0 mt-1">
                      <svg width="12" height="12" viewBox="0 0 12 12" fill="none"><path d="M2 6l3 3 5-5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
                    </span>
                    <span class="text-sm text-[#A1A1AA] leading-snug">{f.text}</span>
                  </li>
                ))}
              </ul>
            </div>
            <div class="px-8 py-6 border-t border-white/[0.06] min-h-[10rem] flex flex-col justify-center" style="background:rgba(255,255,255,.01);">
              <a href={APP_URL} class="btn-primary w-full justify-center text-center">
                Get started
              </a>
            </div>
          </div>

          <div class="rounded-2xl overflow-hidden flex flex-col" style="border:1px solid rgba(129,140,248,.55); background:#0a0a0d; box-shadow:0 0 80px rgba(129,140,248,.25), inset 0 1px 0 rgba(255,255,255,.04);">

            <div class="px-8 py-8 border-b border-white/[0.06]">
              <div class="flex items-start justify-between gap-4">
                <div>
                  <p class="text-xs text-[#818CF8] uppercase tracking-widest font-bold mb-3">Enterprise</p>
                  <div class="flex items-baseline gap-2 mb-2">
                    <span class="text-5xl font-bold text-[#FAFAFA] tracking-tight">Custom</span>
                  </div>
                  <p class="text-[#71717A] text-sm">For teams · we set the plan with you</p>
                </div>
                
              </div>
            </div>

            <div class="px-8 py-8 flex-1">
              <p class="text-xs text-[#52525B] uppercase tracking-widest font-semibold mb-6">What's included</p>
              <ul class="grid grid-cols-1 gap-3">
                {enterprise.map(f => (
                  <li class="flex items-start gap-3">
                    <span class="text-primary flex-shrink-0 mt-1">
                      <svg width="12" height="12" viewBox="0 0 12 12" fill="none"><path d="M2 6l3 3 5-5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
                    </span>
                    <span class="text-sm text-[#A1A1AA] leading-snug">{f.text}</span>
                  </li>
                ))}
              </ul>
            </div>

            <div class="px-8 py-6 border-t border-white/[0.06] min-h-[10rem] flex flex-col justify-center items-stretch gap-3" style="background:rgba(255,255,255,.01);">
              <a
                href={CONTACT_URL}
                class="btn-primary w-full text-center"
              >
                Contact us
              </a>
              <p class="text-[#52525B] text-sm text-center">We'll reply to set up a call and agree price and seats.</p>
            </div>

          </div>
        </div>
      </div>
    </section>
    <CTASection />
  </main>
  <Footer />
</BaseLayout>

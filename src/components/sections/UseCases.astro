---
const tabs = [
  {
    id: "pipeline",
    label: "Pipeline",
    description: "Open pipeline from the CRM, checked against what the calls actually support.",
    benefits: [
      { title: "Open pipeline by stage", body: "See the book the CRM shows, stage by stage, including deals with no amount so they are not silently dropped." },
      { title: "Which deals the calls don’t support", body: "A stage can say Commit while the last call has no next step, an open objection, or nobody spoken to in weeks." },
      { title: "What needs you this week", body: "Ask which deals need a person now. The answer names the deal, the blocker, and the call it came from." },
      { title: "Risk you can check", body: "Stalled contact, unresolved objections, and a single champion are read from the conversations, not from a rep’s stage note." },
      { title: "Ask it in Claude or ChatGPT (beta)", body: "“Do we have enough pipeline?” and “which deals are shaky?” run on your CRM and the calls linked to those deals." },
      { title: "No invented coverage number", body: "Open pipeline and risk are available today. Coverage against quota waits until quota data is connected — Starmesh will say so." },
    ],
  },
  {
    id: "health",
    label: "Customer health",
    description: "Whether a deal is moving, and the story of an account, from the calls and the CRM.",
    benefits: [
      { title: "Is this deal actually moving?", body: "Deal health checks open commitments, objections that were never resolved, how long since the last touch, and how many people are engaged." },
      { title: "The quote, not a score", body: "Each claim points at the moment on the call. A thin deal — one conversation, or calls that may not belong to it — is called out as a thin read." },
      { title: "Brief me on this account", body: "Account health is the story: what happened, what changed, what’s still open, and what you’d do next. Prose, with dates." },
      { title: "Who went quiet", body: "A champion who stopped replying, a new stakeholder, or a shifted ask shows up as a change, not as a health-score delta." },
      { title: "What’s owed, and by whom", body: "Commitments past their date, objections still open, and questions nobody answered — each tied to the conversation." },
      { title: "Same sources as pipeline", body: "Salesforce or Attio, plus Zoom, Granola, Gong, or Teams. Email and calendar when you connect them. One book, two questions." },
    ],
  },
];
---
<section id="benefits" class="py-24 px-6">
  <div class="max-w-6xl mx-auto">
    <div class="text-center mb-8">
      <p class="text-xs text-[#71717A] uppercase tracking-widest mb-3">Benefits</p>
      <h2 class="text-3xl md:text-4xl font-bold tracking-tight mb-4">
        Two questions the product <span class="gradient-text">answers today</span>
      </h2>
      <p class="text-[#A1A1AA] text-lg max-w-2xl mx-auto">Pipeline management and customer health, from the CRM and the calls already on the deal or account.</p>
    </div>

    <!-- Tab inputs (hidden) -->
    {tabs.map((tab, i) => (
      <input type="radio" name="use-case-tab" id={`tab-${tab.id}`} class="sr-only" checked={i === 0} />
    ))}

    <!-- Tab labels (same design as How it works) -->
    <div class="benefits-pills" role="tablist" aria-label="Benefits by team">
      {tabs.map((tab, i) => (
        <label for={`tab-${tab.id}`} class={`benefits-tab tab-label ${i === 0 ? 'active' : ''}`} data-tab={tab.id}>
          {tab.label}
        </label>
      ))}
    </div>

    <!-- Tab panels -->
    {tabs.map((tab) => (
      <div class="tab-panel hidden" data-panel={tab.id}>
        <p class="text-center text-[#A1A1AA] mb-6 text-base max-w-2xl mx-auto">{tab.description}</p>
        <div class="w-full max-w-4xl mx-auto">
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-x-10 gap-y-6">
          {tab.benefits.map((b) => (
            <div class="flex gap-3">
              <svg class="mt-0.5 flex-shrink-0" width="14" height="14" viewBox="0 0 16 16" fill="none">
                <path d="M3 8l3.5 3.5L13 4" stroke="#818CF8" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
              <div>
                <p class="text-sm font-semibold text-[#E4E4E7] mb-0.5">{b.title}</p>
                <p class="text-xs text-[#A1A1AA] leading-relaxed">{b.body}</p>
              </div>
            </div>
          ))}
          </div>
        </div>
      </div>
    ))}
  </div>
</section>

<script>
  const inputs = document.querySelectorAll('input[name="use-case-tab"]');
  const panels = document.querySelectorAll('.tab-panel') as NodeListOf<HTMLElement>;
  const labels = document.querySelectorAll('.tab-label') as NodeListOf<HTMLElement>;

  function showTab(tabId: string) {
    panels.forEach(p => { p.style.display = 'none'; });
    labels.forEach(l => l.classList.remove('active'));
    const panel = document.querySelector(`.tab-panel[data-panel="${tabId}"]`) as HTMLElement;
    const label = document.querySelector(`.tab-label[data-tab="${tabId}"]`) as HTMLElement;
    if (panel) panel.style.display = 'block';
    if (label) label.classList.add('active');
  }

  inputs.forEach(input => {
    input.addEventListener('change', () => {
      showTab((input as HTMLInputElement).id.replace('tab-', ''));
    });
  });

  showTab('pipeline');
</script>

<style>
  .benefits-pills {
    display: flex;
    gap: .25rem;
    background: rgba(255,255,255,.03);
    border-radius: .7rem;
    padding: .2rem;
    width: fit-content;
    margin: 0 auto 1.25rem;
  }
  .benefits-tab {
    border-radius: .5rem;
    border: 1px solid transparent;
    padding: .35rem 1.1rem;
    background: transparent;
    color: var(--color-muted-foreground);
    font-weight: 600;
    font-size: .875rem;
    cursor: pointer;
    transition: all .18s ease;
    -webkit-tap-highlight-color: transparent;
  }
  .benefits-tab.active {
    background: rgba(99,102,241,.22);
    color: var(--color-primary-foreground);
    box-shadow: 0 4px 14px rgba(99,102,241,.25);
    border-color: rgba(99,102,241,.25);
  }
  .benefits-tab:hover:not(.active) {
    background: rgba(99,102,241,.08);
    color: var(--color-foreground);
  }
</style>

---
import { APP_URL } from '../../config';
---
<section class="py-24 px-6 relative overflow-hidden">
  <!-- Same glow as hero (global class .section-glow-orb) -->
  <div class="absolute inset-0 z-[1] flex items-center justify-center pointer-events-none" aria-hidden="true">
    <div class="section-glow-orb"></div>
  </div>

  <div class="relative z-[2] max-w-2xl mx-auto text-center">
    <h2 class="text-3xl md:text-4xl font-bold tracking-tight mb-4">
      Ask your pipeline and<br />
      <span class="gradient-text">your accounts</span>
    </h2>
    <p class="text-[#A1A1AA] text-lg mb-10">
      Sign up free and start on sample data. Connect your own CRM and calls when you are ready.
    </p>
    <a href={APP_URL} class="btn-primary">Get started</a>
  </div>
</section>
